    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: asis\n",
        "\n",
        "from pubs_lib import load_entries, format_authors, meta_line\n",
        "\n",
        "for i, entry in enumerate(load_entries(), start=1):\n",
        "    title = entry.get(\"title\", \"\").strip(\"{}\")\n",
        "    authors = format_authors(entry.get(\"author\", \"\"), style=\"initials\")\n",
        "    meta = meta_line(entry)\n",
        "    print(f\"{i}. {authors} ({entry.get('year','')}). {title}. {meta.rsplit(' (', 1)[0]}.\")"
      ],
      "id": "b3c96481",
      "execution_count": null,
      "outputs": []
    },
