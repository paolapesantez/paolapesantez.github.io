{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"Publications\"\n",
        "date-modified: \"2026-08-18\"\n",
        "---\n",
        "\n",
        "<div class=\"hero-eyebrow\">Peer-reviewed &amp; preprints, newest first</div>\n",
        "\n",
        "<p>Generated automatically from <code>references.bib</code> — add or edit an\n",
        "entry there and re-render; nothing here needs to be touched by hand.\n",
        "<a href=\"references.bib\" download>Download all as BibTeX ↓</a></p>"
      ],
      "id": "a8f9f5ac"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| output: asis\n",
        "\n",
        "import html as _html\n",
        "from pubs_lib import load_entries, format_authors, meta_line, links_line, stamp_for, to_bibtex_string\n",
        "\n",
        "for entry in load_entries():\n",
        "    stamp_text, stamp_class = stamp_for(entry)\n",
        "    year = entry.get(\"year\", \"\")\n",
        "    title = entry.get(\"title\", \"\").strip(\"{}\")\n",
        "    authors = format_authors(entry.get(\"author\", \"\"))\n",
        "    meta = meta_line(entry)\n",
        "    note = entry.get(\"note\")\n",
        "    links = links_line(entry)\n",
        "\n",
        "    bibtex_escaped = _html.escape(to_bibtex_string(entry))\n",
        "\n",
        "    print('<div class=\"pub-card\">')\n",
        "    print(f'<div class=\"pub-year\">{year}</div>')\n",
        "    print('<div>')\n",
        "    print(f'<span class=\"stamp {stamp_class}\">{stamp_text}</span>')\n",
        "    print()\n",
        "    print(f'### {title}')\n",
        "    print()\n",
        "    print(f'{authors}. {meta}')\n",
        "    print()\n",
        "    if note:\n",
        "        print(f'<div class=\"pub-meta\">{note}</div>')\n",
        "\n",
        "    print('<div class=\"pub-links\">')\n",
        "    print(\"\\n\".join(links))\n",
        "    print('<a href=\"#\" class=\"cite-toggle\" onclick=\"'\n",
        "          f\"this.closest('.pub-links').querySelector('.cite-box').classList.toggle('open');return false;\"\n",
        "          '\">Cite</a>')\n",
        "    print('</div>')\n",
        "\n",
        "    print(f'<pre class=\"cite-box\"><code>{bibtex_escaped}</code></pre>')\n",
        "\n",
        "    print('</div>')\n",
        "    print('</div>')\n",
        "    print()"
      ],
      "id": "a1260685",
      "execution_count": null,
      "outputs": []
    }
  ],
